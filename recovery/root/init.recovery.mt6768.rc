import /init.microtrust.rc
import /init.recovery.usb.rc
import /init.vibrator.rc

on early-init
    write /proc/bootprof "RECOVERY:early-init"
    setprop vendor.all.modules.ready 1

on init
    # Установка библиотек
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw

    # Настройка USB
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

    # Разрешения для I2C
    chmod 0660 /dev/bus/i2c-0
    chown root root /dev/bus/i2c-0

    # Разрешения для GPIO
    chmod 0660 /sys/class/gpio/export
    chmod 0660 /sys/class/gpio/unexport
    chown root root /sys/class/gpio/export
    chown root root /sys/class/gpio/unexport

    # Разрешения для регуляторов питания
    chmod 0660 /sys/class/regulator/
    chown root root /sys/class/regulator/

on post-fs
    start create_pl_dev

    # Включение питания для touchpanel
    write /sys/class/regulator/regulator.29/enabled 1
    write /sys/class/regulator/regulator.39/enabled 1

    # Сброс TP (RESET GPIO 152)
    write /sys/class/gpio/gpio152/value 0
    sleep 0.1
    write /sys/class/gpio/gpio152/value 1
    sleep 0.1

    # IRQ (GPIO 42)
    chmod 0660 /sys/class/gpio/gpio42/value
    chown root root /sys/class/gpio/gpio42/value

    # Загрузка модулей ядра
    insmod /vendor/lib/modules/xiaomi_touch.ko
    insmod /vendor/lib/modules/alspshub.ko
    insmod /vendor/lib/modules/alsps_common.ko
    insmod /vendor/lib/modules/tpd_notify.ko
    insmod /vendor/lib/modules/focaltech_tp.ko

on late-fs
    # Ждём keymaster
    exec_start wait_for_keymaster

    # Монтирование разделов
    mount_all /first_stage_ramdisk/fstab.mt6768 --late

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

# Gatekeeper HAL
service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# Keymaster HAL (BeanPod)
service vendor.keymaster-4-1-beanpod /vendor/bin/hw/android.hardware.keymaster@4.1-service.beanpod
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    user root
    group root drmrpc
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Запуск keymaster после готовности crypto
on property:crypto.ready=1
    start vendor.keymaster-4-1-beanpod

# Запуск gatekeeper и keymaster после hw servicemanager
on property:hwservicemanager.ready=true
    start vendor.keymaster-4-1-beanpod
    start vendor.gatekeeper-1-0

# Остановка сервисов при отсутствии шифрования
on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop vendor.keymaster-4-1-beanpod
    stop vendor.gatekeeper-1-0

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop vendor.keymaster-4-1-beanpod
    stop vendor.gatekeeper-1-0

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop vendor.keymaster-4-1-beanpod
    stop vendor.gatekeeper-1-0

on property:crypto.ready=0
    stop teei_daemon
    stop vendor.keymaster-4-1-beanpod
    stop vendor.gatekeeper-1-0

# Сервис вибратора
on property:twrp.modules.loaded=true
    start vendor.vibrator-default

# Запуск HAL
on boot
    start boot-hal-1-2
    start health-hal-2-1
